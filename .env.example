# Пример файла окружения PicPac. Скопируйте: cp .env.example .env.local и впишите свои значения.
# .env.local в git не попадает. Здесь только имена переменных — никаких настоящих ключей.

# --- Supabase (Settings → API) — обязательно ---
# Адрес проекта, вид: https://<id-проекта>.supabase.co
SUPABASE_URL=
# Публичный ключ (publishable или старый anon) — запросы от имени пользователя, с правилами RLS
SUPABASE_PUBLISHABLE_KEY=
# Секретный ключ (secret или старый service_role) — только сервер и скрипты; не публиковать
SUPABASE_SECRET_KEY=

# --- База (Settings → Database → Connection string, Direct connection) — для npm run db:migrate и db:backup ---
# Вид: postgresql://postgres:<пароль-базы>@db.<id-проекта>.supabase.co:5432/postgres
POSTGRES_URL_NON_POOLING=

# --- Свои значения ---
# Пароли демо-аккаунтов для npm run seed и test:auth (придумайте свои, от 12 символов)
SEED_PASSWORD_CLIENT=
SEED_PASSWORD_MODERATOR=
SEED_PASSWORD_ADMIN=
# Соль для обезличенной аналитики (любая длинная случайная строка, например: openssl rand -hex 32)
ANALYTICS_SALT=

# --- Необязательно ---
# true — код 2FA обязателен для модератора и админа (на демо выключено)
REQUIRE_STAFF_MFA=false
