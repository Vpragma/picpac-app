{
  "name": "picpac-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "test:auth": "node --env-file-if-exists=.env.local scripts/test-auth.mjs",
    "test:mfa": "node --env-file-if-exists=.env.local scripts/test-mfa.mjs",
    "env:sync": "node scripts/env-sync.mjs",
    "env:night-secrets": "node --env-file-if-exists=.env.local scripts/night-secrets.mjs",
    "db:backup": "node --env-file-if-exists=.env.local scripts/db-backup.mjs",
    "seed:catalog": "node --env-file-if-exists=.env.local scripts/seed-catalog.mjs",
    "lint": "eslint .",
    "test:unit": "node --test tests/unit/",
    "test:api": "node --env-file-if-exists=.env.local --test --test-concurrency=1 tests/api/",
    "e2e": "playwright test",
    "test:all": "node --env-file-if-exists=.env.local scripts/test-all.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@huggingface/transformers": "^4.3.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tensorflow/tfjs": "^4.11.0",
    "@upscalerjs/esrgan-slim": "^1.0.0",
    "buffer": "^6.0.3",
    "idb": "^8.0.4",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "nsfwjs": "^4.3.0",
    "onnxruntime-web": "^1.31.1",
    "postgres": "^4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "upscaler": "^1.0.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "26.x"
  },
  "overrides": {
    "@babel/generator": "7.29.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6"
  }
